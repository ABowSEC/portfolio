// Cloudflare deploy config. The site is a static export (`output: "export"`),
// so the Worker just serves the files `npm run build` writes to out/.
// Having this file also stops `wrangler deploy` from auto-converting the
// project to a server build (OpenNext), which doesn't apply to static exports.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abowsec",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
